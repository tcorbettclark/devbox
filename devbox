#!/usr/bin/env fish

# ── configuration (hardcoded) ─────────────────────────────────────────────
set -g _devbox_dir (realpath (dirname (status --current-filename)))
set -g DEVBOX_IMAGE          devbox:latest
set -g DEVBOX_TARGET         devbox
set -g DEVBOX_DNS_DOMAIN     machine
set -g DEVBOX_SSH_KEY        "$HOME/.ssh/id_ed25519"
set -g DEVBOX_USER           $USER
set -g DEVBOX_DOTFILES_REPO  $USER/dotfiles
# Per-machine VM resources. Defaults mirror a small DigitalOcean droplet
# (2G RAM, 2 vCPUs) so memory/CPU pressure surfaces locally before it bites
# in production. The platform default is ~half the host (e.g. 16G, 5 cpus
# here), which both wastes RAM and hides real-world constraints.
set -g DEVBOX_MEMORY         2G
set -g DEVBOX_CPUS           2

# ── helpers ─────────────────────────────────────────────────────────────────
function _devbox_usage
    echo "Usage: devbox <subcommand> [name] [options...]"
    echo
    echo "Subcommands:"
    echo "  build [--no-cache]           build the image (refreshes ./authorized_keys;"
    echo "                               --no-cache forces a full rebuild, ignoring layer cache)"
    echo "  create <name>                create + start machine (memory=$DEVBOX_MEMORY, cpus=$DEVBOX_CPUS, --home-mount=none)"
    echo "  start <name>                 start a stopped machine"
    echo "  stop <name>                  stop a running machine"
    echo "  ssh <name>                   ssh <name>.<domain> (agent forwarded)"
    echo "  run <name> [args...]         passthrough to `container machine run -n <name>`"
    echo "  inspect <name>               inspect a machine"
    echo "  list                         list all machines"
    echo "  destroy <name>               stop + delete (y/N confirm)"
    echo "  git-clone <name> <repo>      clone git@github.com:$USER/<repo>.git into <name>.machine"
    echo "  help                         this message"
end

function _devbox_require_name --argument-names cmd
    set -l name $argv[2]
    if test -z "$name"
        echo "Error: '$cmd' requires a machine name." >&2
        echo "Usage: devbox $cmd <name>" >&2
        return 1
    end
    return 0
end

function _setup_dns
    set -l name $argv[1]
    set -l host $name.$DEVBOX_DNS_DOMAIN
    if not contains $DEVBOX_DNS_DOMAIN (container system dns list -q 2>/dev/null)
        echo "Creating DNS domain '$DEVBOX_DNS_DOMAIN' (requires sudo)..."
        sudo container system dns create $DEVBOX_DNS_DOMAIN
        or return
    end
end

function _create_ssh_config
    set -l name $argv[1]
    set -l host $name.$DEVBOX_DNS_DOMAIN
    set -l cfgdir $HOME/.ssh/config.d
    set -l cfgfile $cfgdir/$name.machine
    mkdir -p $cfgdir
    if not test -f $cfgfile
        echo "Writing 'Host $host' block to $cfgfile..."
        printf 'Host %s\n  User %s\n  IdentityFile %s\n  ForwardAgent yes\n  SendEnv PI_OLLAMA_KEY\n  UserKnownHostsFile /dev/null\n  StrictHostKeyChecking no\n' \
            $host $DEVBOX_USER $DEVBOX_SSH_KEY >$cfgfile
    end
end

function _delete_ssh_config
    set -l name $argv[1]
    set -l cfgdir $HOME/.ssh/config.d
    set -l cfgfile $cfgdir/$name.machine
    if test -f $cfgfile
        rm -f $cfgfile
        echo "Removed $cfgfile"
    end
end


# ── subcommands ─────────────────────────────────────────────────────────────
function _devbox_build
    argparse --name=devbox-build 'no-cache' -- $argv
    or return

    set -l pubkey $DEVBOX_SSH_KEY.pub
    if not test -f $pubkey
        echo "Error: public key not found at $pubkey" >&2
        echo "Set DEVBOX_SSH_KEY or generate a key first." >&2
        return 1
    end

    # Git identity for the baked .gitconfig — read from the current user's git
    # config so nothing is hardcoded in the image.
    set -l git_name  (git config user.name)
    set -l git_email (git config user.email)
    if test -z "$git_name" -o -z "$git_email"
        echo "Error: git user.name/user.email not set (run `git config --global`)." >&2
        return 1
    end

    echo "Copying $pubkey → $_devbox_dir/authorized_keys"
    cp $pubkey $_devbox_dir/authorized_keys
    or return

    # Seed the build context with the host's mkcert root CA so the image
    # trusts (and signs with) the same CA the host's Keychain already trusts.
    # `mkcert -install` must have been run on the host first (it creates the CA
    # and installs it into the Keychain). The CA *key* is secret, so the build
    # context dir is gitignored.
    set -l ca_root (mkcert -CAROOT 2>/dev/null)
    set -l ca_dir $_devbox_dir/mkcert-ca
    if test -z "$ca_root" -o ! -f "$ca_root/rootCA.pem" -o ! -f "$ca_root/rootCA-key.pem"
        echo "Error: host mkcert root CA not found." >&2
        echo "Run on the host (one time): brew install mkcert && mkcert -install" >&2
        return 1
    end
    echo "Copying host mkcert CA ($ca_root) → $ca_dir"
    rm -rf $ca_dir
    mkdir -p $ca_dir
    cp "$ca_root/rootCA.pem" "$ca_root/rootCA-key.pem" $ca_dir/
    or return

    set -l cache_note
    set -l build_args --target $DEVBOX_TARGET -t $DEVBOX_IMAGE
    if set -q _flag_no_cache
        set -a build_args --no-cache
        set cache_note " (no cache; rebuilds every layer)"
    end

    # Forward the current user's identity into the build (required; the
    # Containerfile has no defaults and fails fast if any are missing).
    set -a build_args \
        --build-arg USER_NAME=$DEVBOX_USER \
        --build-arg GIT_NAME=$git_name \
        --build-arg GIT_EMAIL=$git_email \
        --build-arg DOTFILES_REPO=$DEVBOX_DOTFILES_REPO

    echo "Building target '$DEVBOX_TARGET' → tag '$DEVBOX_IMAGE'$cache_note..."
    cd $_devbox_dir
    container build $build_args .
    and echo "Build completed."
end

function _devbox_create
    set -l name $argv[1]
    _devbox_require_name create $name; or return

    _setup_dns $name
    _create_ssh_config $name

    echo "Creating machine '$name' from '$DEVBOX_IMAGE' (memory=$DEVBOX_MEMORY, cpus=$DEVBOX_CPUS, home-mount=none)..."
    # --home-mount=none is the safety boundary: never mount the host home dir.
    # `container machine create` boots the machine by default.
    container machine create --home-mount=none --memory $DEVBOX_MEMORY --cpus $DEVBOX_CPUS --name $name $DEVBOX_IMAGE >/dev/null
    and echo "Machine '$name' is up."
end

function _devbox_start
    set -l name $argv[1]
    _devbox_require_name start $name; or return
    # `container machine` has no `start` subcommand; `run` boots a stopped
    # machine. Run /bin/true so we boot without leaving a shell process behind.
    container machine run -n $name -- /bin/true
    and echo "Machine '$name' started."
end

function _devbox_stop
    set -l name $argv[1]
    _devbox_require_name stop $name; or return
    container machine stop $name >/dev/null
    and echo "Machine '$name' stopped."
end

function _devbox_ssh
    set -l name $argv[1]
    _devbox_require_name ssh $name; or return
    exec ssh $name.$DEVBOX_DNS_DOMAIN
end

function _devbox_run
    set -l name $argv[1]
    _devbox_require_name run $name; or return
    set -e argv[1]
    # Forward everything else (including `--`, `-e K=V`, and the command) verbatim.
    container machine run -n $name $argv
end

function _devbox_inspect
    set -l name $argv[1]
    _devbox_require_name inspect $name; or return
    container machine inspect $name
end

function _devbox_list
    container machine list
end

function _devbox_git_clone
    set -l name $argv[1]
    _devbox_require_name git-clone $name; or return
    set -l repo $argv[2]
    if test -z "$repo"
        echo "Error: 'git-clone' requires a repo name." >&2
        echo "Usage: devbox git-clone <name> <repo>" >&2
        return 1
    end
    # Clone one of the current user's GitHub repos by name into the named
    # machine over SSH. The forwarded agent (ForwardAgent yes in the ssh
    # config) authorises pushes from inside the machine.
    set -l url git@github.com:$DEVBOX_USER/$repo.git
    echo "Cloning $url into '$name'..."
    ssh $name.$DEVBOX_DNS_DOMAIN "git clone $url"
end

function _devbox_destroy
    set -l name $argv[1]
    _devbox_require_name destroy $name; or return

    echo "This will STOP and DELETE machine '$name' and its filesystem."
    echo "Any uncommitted work inside is LOST — push to git first."
    read -l -P "Destroy '$name'? [y/N] " confirm
    if not string match -qr '^[yY]$' -- $confirm
        echo "Aborted."
        return
    end
    # Suppress the bare-name stdout echo; keep stderr (real errors) visible.
    container machine stop $name >/dev/null
    container machine delete $name >/dev/null

    _delete_ssh_config $name
end

# ── dispatch ────────────────────────────────────────────────────────────────
set -l cmd $argv[1]
set -e argv[1]

switch $cmd
    case build    ; _devbox_build $argv
    case create   ; _devbox_create $argv
    case start    ; _devbox_start $argv
    case stop     ; _devbox_stop $argv
    case ssh      ; _devbox_ssh $argv
    case run      ; _devbox_run $argv
    case inspect  ; _devbox_inspect $argv
    case list     ; _devbox_list $argv
    case git-clone; _devbox_git_clone $argv
    case destroy  ; _devbox_destroy $argv
    case help -h --help '' ; _devbox_usage
    case '*'
        echo "Unknown subcommand: '$cmd'" >&2
        echo
        _devbox_usage >&2
        exit 1
end
